# Model: any OpenAI-compatible API. Default = Ollama on your laptop (free).
BASE_URL=http://localhost:11434/v1
CHAT_MODEL=llama3.2
API_KEY=none

# LangSmith (optional, needs an account + API key). Never commit the real key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=langchain-ecosystem
